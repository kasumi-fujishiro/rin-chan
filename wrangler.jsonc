{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rin-chan",
  "account_id": "92ba3d870844d6a7582510fa6b2156b7",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // LINE で家族が送った伝言を、iPad が受け取るまでだけ置く(受け取ったら消す。受け取られなくても3日で消える)
  "kv_namespaces": [{ "binding": "RIN_INBOX", "id": "50b4cf4f1ff34f0ea29822684eba453e" }]
  // ANTHROPIC_API_KEY・LINE_CHANNEL_ACCESS_TOKEN・LINE_CHANNEL_SECRET・RIN_APP_KEY は `wrangler secret put` で入れる(リポジトリには書かない)
}
